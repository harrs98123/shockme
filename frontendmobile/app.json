{
  "expo": {
    "name": "plotmint",
    "slug": "plotmint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios/iTunesArtwork@2x.png",
    "scheme": "plotmint",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/ios/iTunesArtwork@2x.png"
    },
    "android": {
      "package": "com.plotmint.myapp",
      "adaptiveIcon": {
        "backgroundColor": "#02022c",
        "foregroundImage": "./assets/android/mipmap-xxxhdpi/plotmint_foreground.png",
        "backgroundImage": "./assets/android/mipmap-xxxhdpi/plotmint.png",
        "monochromeImage": "./assets/android/mipmap-xxxhdpi/plotmint_foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08011D",
          "image": "./assets/images/splash-pm.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0F0F0F",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a702d11-10c6-4031-a873-4f2a54f79b53"
      }
    }
  }
}