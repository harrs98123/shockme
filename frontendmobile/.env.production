# Loaded automatically by Expo CLI whenever NODE_ENV=production — i.e. every
# `expo export` and every EAS Build (preview and production profiles alike),
# regardless of the eas.json `environment` field.
#
# Committed on purpose: every value here is an EXPO_PUBLIC_* variable, which is
# inlined into the JS bundle at build time and therefore already public. Never
# put a secret in this file. Local development keeps using `.env`.

EXPO_PUBLIC_API_URL=https://shockme-1.onrender.com
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=dou7tixmc
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=social-ai
