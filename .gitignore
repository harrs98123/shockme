# Dependencies
node_modules/
*/node_modules/

# Environment variables & secrets
.env
.env.*
*.env
*.env.local
backend/.env
frontend/.env
frontend/.env.local
frontendmobile/.env
frontendmobile/.env.local

# Exception: mobile build-time config. Every value is an EXPO_PUBLIC_* variable
# (inlined into the JS bundle, already public) and must be committed so EAS
# Build / `expo export` pick it up. Never add a secret to these files.
!frontendmobile/.env.production
!frontendmobile/.env.preview

# Databases & local state
backend/cinematch.db
backend/*.db
backend/*.sqlite*
backend/*.sqlite3

# Python
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/

